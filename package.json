{
  "name": "lumina",
  "private": true,
  "scripts": {
    "dev:web": "bun apps/web/server.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "bun --cwd tests test",
    "test:integration": "bun --cwd tests test:integration",
    "test:coverage": "bun --cwd tests test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml,yaml}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "supertest": "^7.1.4",
    "prettier": "^3.7.4",
    "prisma": "^7.9.1",
    "vitest": "^3.2.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5"
  },
  "resolutions": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.0"
    }
  },
  "workspaces": [
    "tests",
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "better-auth": "^1.6.25",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  }
}
