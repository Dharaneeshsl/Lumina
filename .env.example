# ==============================================================================
# Lumina — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------

# Primary PostgreSQL connection string (used by Prisma with connection pooling)
DATABASE_URL="postgresql://lumina_user:your_password@localhost:5432/lumina_dev?schema=public"

# Direct (non-pooled) connection — required for Prisma migrations
DIRECT_URL="postgresql://lumina_user:your_password@localhost:5432/lumina_dev?schema=public"

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------

# Redis connection string (used for sessions, caching, and queues)
# For Upstash: rediss://:<token>@<host>:<port>
REDIS_URL="redis://localhost:6379"

# Redis key prefix (useful when sharing a Redis instance across environments)
REDIS_KEY_PREFIX="lumina:"

# ------------------------------------------------------------------------------
# AUTHENTICATION (better-auth)
# ------------------------------------------------------------------------------

# Secret key for signing JWTs and cookies — must be at least 32 characters
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-very-long-secret-key-at-least-32-chars"

# The public URL of your auth server (usually same as your app URL)
BETTER_AUTH_URL="http://localhost:3000"

# Session duration in seconds (default: 7 days)
BETTER_AUTH_SESSION_EXPIRY="604800"

# ------------------------------------------------------------------------------
# OAUTH — GOOGLE
# ------------------------------------------------------------------------------

# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# OAUTH — GITHUB
# ------------------------------------------------------------------------------

# Get these from https://github.com/settings/applications/new
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# EMAIL (Resend)
# ------------------------------------------------------------------------------

# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=""

# The "from" address for all outgoing emails (must be a verified domain in Resend)
EMAIL_FROM="Lumina <noreply@luminohq.com>"

# Reply-to address for support emails
EMAIL_REPLY_TO="support@luminohq.com"

# ------------------------------------------------------------------------------
# STORAGE (AWS S3 / Cloudflare R2 / Google Cloud Storage)
# ------------------------------------------------------------------------------

# AWS S3 configuration
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="lumina-uploads"

# For Cloudflare R2, set the endpoint URL:
# S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"

# Max file upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE_BYTES="10485760"

# ------------------------------------------------------------------------------
# REAL-TIME (Pusher)
# ------------------------------------------------------------------------------

# Get these from https://dashboard.pusher.com/
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"

# Public Pusher key (safe to expose to the browser)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# ------------------------------------------------------------------------------
# AI (OpenAI)
# ------------------------------------------------------------------------------

# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# The model to use for AI features
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL="gpt-4o"

# Maximum tokens per AI response
OPENAI_MAX_TOKENS="2048"

# ------------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# ------------------------------------------------------------------------------

# Get your DSN from https://sentry.io/
SENTRY_DSN=""
SENTRY_ORG="lumina"
SENTRY_PROJECT="lumina-web"

# Public DSN (safe to expose to the browser)
NEXT_PUBLIC_SENTRY_DSN=""

# ------------------------------------------------------------------------------
# ANALYTICS
# ------------------------------------------------------------------------------

# PostHog for product analytics (https://posthog.com/)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------

# Environment — one of: development, staging, production
NODE_ENV="development"

# The public URL of your web application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The public URL of your dashboard application
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:5173"

# Log level — one of: trace, debug, info, warn, error, fatal
LOG_LEVEL="debug"

# Enable or disable feature flags
FEATURE_AI_COPILOT="true"
FEATURE_REAL_TIME="true"
FEATURE_ANOMALY_DETECTION="false"
