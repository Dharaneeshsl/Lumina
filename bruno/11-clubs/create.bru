meta {
  name: Create club
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/clubs
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
  {
    "name": "Robotics & Automation Society",
    "description": "Fostering research, projects, and competitions in AI and hardware engineering.",
    "category": "ENGINEERING"
  }
}
