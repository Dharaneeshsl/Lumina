meta {
  name: Create club post or announcement
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/clubs/{{clubId}}/posts
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
  {
    "content": "Welcome all new members to the Robotics & Automation Society! Registrations for the upcoming hackathon are now live.",
    "isAnnouncement": true
  }
}
