meta {
  name: Ingest analytics event
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/analytics/events
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
  {
    "eventType": "navigation_page_view",
    "domain": "INTERNSHIPS",
    "entityId": "internship-123",
    "payload": {
      "page": "/internships/123",
      "referrer": "/internships"
    }
  }
}

assert {
  res.status: eq 200
}
