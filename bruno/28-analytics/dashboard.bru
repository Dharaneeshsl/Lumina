meta {
  name: Get analytics dashboard metrics
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/analytics/dashboard
  body: none
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

assert {
  res.status: eq 200
}
