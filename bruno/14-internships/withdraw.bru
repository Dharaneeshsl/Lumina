meta {
  name: Withdraw application
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/internships/{{internshipId}}/withdraw
  body: none
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

assert {
  res.status: eq 200
}
