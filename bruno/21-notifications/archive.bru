meta {
  name: Archive notification
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/notifications/{{notificationId}}/archive
  body: none
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

assert {
  res.status: eq 200
}
