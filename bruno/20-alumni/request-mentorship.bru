meta {
  name: Request mentorship session
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/alumni/mentorship/sessions
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
  {
    "alumniId": "{{alumniUserId}}",
    "topic": "Career Transition to Machine Learning & Systems",
    "notes": "Looking for advice on portfolio projects and interview prep.",
    "durationMinutes": 30
  }
}

assert {
  res.status: eq 201
}
