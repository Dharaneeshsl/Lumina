meta {
  name: List mentorship sessions
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/alumni/mentorship/sessions
  body: none
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

assert {
  res.status: eq 200
}
