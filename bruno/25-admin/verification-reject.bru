meta {
  name: Reject verification
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/verification/{{verificationId}}/reject
  body: json
  auth: inherit
}

headers {
  Origin: {{origin}}
  Accept: application/json
  Cookie: better-auth.session_token={{sessionToken}}
}

body:json {
  {
    "rejectionReason": "Documents could not be verified by registrar."
  }
}

assert {
  res.status: eq 200
}
